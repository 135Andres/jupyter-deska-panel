{
  "name": "notebook-viewer",
  "version": "0.2.0",
  "private": true,
  "description": "Read Jupyter notebooks in Deska.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "csp-lint": "node scripts/csp-lint.mjs",
    "validate:deska": "node scripts/validate-deska.mjs",
    "check:deska": "node scripts/check-deska.mjs",
    "preview:deska": "node scripts/preview-deska.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "ansi_up": "6.0.6",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "preact": "11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
